8nFxERqMPydAMtO40.jpg</td><td>7.42</td><td>127</td><td>5.7</td><td>0.0</td><td>0.0</td><td>84</td><td>Released</td><td>false</td><td>/itG5rMUHXC1GZzXEjVS5XpTI1iH.jpg</td><td>Drama, Fantasy, History, Horror</td><td>NA</td><td>NA</td></tr><tr><td>304613</td><td>Charlie's Farm</td><td>Charlie's Farm</td><td>en</td><td>Four friends head into the Australian Outback to investigate an urban legend about Charlie's Farm, where legend has it that an angry mob killed a sadistic family, and encounter a demented giant with a big thirst for revenge.</td><td>His Home. His Rules. Your Life.</td><td>2014-12-04</td><td>/kTYBbY9AvbpNdcKEBcK5OwEu72H.jpg</td><td>7.416</td><td>84</td><td>4.8</td><td>3000000.0</td><td>0.0</td><td>93</td><td>Released</td><td>false</td><td>/gHDhln6NUJXWZ4h9t1lhl64HHsT.jpg</td><td>Horror</td><td>NA</td><td>NA</td></tr><tr><td>408185</td><td>Nails</td><td>Nails</td><td>en</td><td>Paralyzed after a terrible accident, Dana struggles to regain her life and family when she encounters a malevolent ghost in her hospital room.</td><td>NA</td><td>2017-06-16</td><td>/uqoZlqWg1L2HaymAZrmWc05l92R.jpg</td><td>7.411</td><td>83</td><td>5.5</td><td>5500000.0</td><td>0.0</td><td>85</td><td>Released</td><td>false</td><td>/4VbZSElasRwGKLrabfiOialeF5m.jpg</td><td>Horror</td><td>NA</td><td>NA</td></tr><tr><td>26503</td><td>Black Cat: Gatto nero</td><td>The Black Cat</td><td>it</td><td>When a young couple goes missing in a sleepy English village, Scotland Yard Inspector Gorley is brought in to assist on the case.  But what starts off as routine investigation turns into a murder inquiry when the couple are found dead in mysterious circumstances.</td><td>When you hear this cat breathing down your neck… start praying… before you finish your Amen… you're dead!</td><td>1981-04-04</td><td>/69bYJOdhjXXVycXd8mZdlpyYgyr.jpg</td><td>7.402</td><td>99</td><td>6.1</td><td>0.0</td><td>0.0</td><td>92</td><td>Released</td><td>false</td><td>/mSdpQhD0AzwKiwGiWhMqn04XbWB.jpg</td><td>Horror</td><td>NA</td><td>NA</td></tr><tr><td>387399</td><td>We Go On</td><td>We Go On</td><td>en</td><td>Paralyzed by his fear of dying, Miles Grissom takes out an advert offering 30000 dollars in reward money to the first person who can show him evidence of an angel, a demon, or prove that ghosts exist - anything to prove to him that we go on after our deaths. He narrows the responses down to three viable candidates - a scientist, a medium, and a worldly entrepreneur. Along with his protective mother, he embarks on an adventure through Los Angeles that will spiral into an unthinkable nightmare.</td><td>Some doors should never be opened.</td><td>2016-03-05</td><td>/dBk6ol8q7kzlU2o7C5LmNmIXCQP.jpg</td><td>7.4</td><td>121</td><td>5.8</td><td>0.0</td><td>0.0</td><td>89</td><td>Released</td><td>false</td><td>/30s3HOJJQ7o99cBT1VbOWHs0D8M.jpg</td><td>Drama, Horror, Thriller</td><td>NA</td><td>NA</td></tr><tr><td>14217</td><td>輪廻</td><td>Reincarnation</td><td>ja</td><td>A Japanese actress begins having strange visions and experiences after landing a role in a horror film about a real-life murder spree that took place over forty years ago.</td><td>Death Is Only The Beginning</td><td>2005-10-26</td><td>/lFAnm6625uMUZ1Xkg1XxwlXBEE.jpg</td><td>7.399</td><td>114</td><td>5.9</td><td>0.0</td><td>4664641.0</td><td>96</td><td>Released</td><td>false</td><td>/bWJcywHAFCYTlGP5EcTywaUVwm9.jpg</td><td>Horror</td><td>NA</td><td>NA</td></tr><tr><td>43089</td><td>Roadgames</td><td>Roadgames</td><td>en</td><td>A truck driver plays a cat-and-mouse game with a mysterious serial killer who uses a young female hitchhiker as bait to lure victims on a desolate Australian highway.</td><td>On the world's loneliest highway it's not a game - it's murder!</td><td>1981-02-27</td><td>/yz0T3R9LeJjh9PRlLCqrMwP8dIq.jpg</td><td>7.397</td><td>117</td><td>6.5</td><td>1750000.0</td><td>100000.0</td><td>101</td><td>Released</td><td>false</td><td>/xR63nhI1jTYsZfoSrzULnz9aQxA.jpg</td><td>Horror, Mystery, Thriller</td><td>NA</t